<mxCell id="codigo" value="&lt;div&gt;Ejemplo:&lt;/div&gt;&lt;div style=&quot;font-size:11px;color:#52606d;&quot;&gt;ts&lt;/div&gt;&lt;pre style=&quot;background-color:#f5f7fa;border:1px solid #d5d9e0;border-radius:4px;padding:10px;font-family:Courier New;&quot;&gt;&lt;i&gt;&lt;span style=&quot;color:#6b7280;&quot;&gt;// Saluda al usuario&lt;/span&gt;&lt;/i&gt;&#xa;&lt;span style=&quot;color:#7c3aed;&quot;&gt;const&lt;/span&gt; saludo = &lt;span style=&quot;color:#0f7b3c;&quot;&gt;&amp;quot;hola&amp;quot;&lt;/span&gt; + &lt;span style=&quot;color:#b45309;&quot;&gt;42&lt;/span&gt;;&#xa;&lt;span style=&quot;color:#7c3aed;&quot;&gt;export&lt;/span&gt; &lt;span style=&quot;color:#7c3aed;&quot;&gt;function&lt;/span&gt; saluda(nombre: string): string {&#xa;  &lt;span style=&quot;color:#7c3aed;&quot;&gt;return&lt;/span&gt; &lt;span style=&quot;color:#0f7b3c;&quot;&gt;`Hola ${nombre}`&lt;/span&gt;;&#xa;}&lt;/pre&gt;" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;strokeColor=none;fillColor=none;fontSize=14;" vertex="1" parent="1"><mxGeometry x="60" y="360" width="440" height="177" as="geometry"/></mxCell>
