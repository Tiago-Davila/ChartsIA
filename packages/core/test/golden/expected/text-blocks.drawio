<mxCell id="notas" value="&lt;h1&gt;Notas &amp;lt;de&amp;gt; diseño&lt;/h1&gt;&lt;div&gt;Un párrafo con &lt;b&gt;negrita&lt;/b&gt;, &lt;i&gt;cursiva&lt;/i&gt; y un texto largo que tiene que partirse en varias líneas para caber en el ancho del bloque de texto.&lt;/div&gt;&lt;div&gt;Segunda línea del mismo párrafo.&lt;/div&gt;&lt;h2&gt;Pasos&lt;/h2&gt;&lt;ul&gt;&lt;li&gt;Crear el modelo&lt;/li&gt;&lt;li&gt;Validar &lt;b&gt;antes&lt;/b&gt; de exportar&lt;/li&gt;&lt;/ul&gt;&lt;h3&gt;Orden&lt;/h3&gt;&lt;ol&gt;&lt;li&gt;Primero&lt;/li&gt;&lt;li&gt;Segundo &amp;amp; último&lt;/li&gt;&lt;/ol&gt;" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;strokeColor=none;fillColor=none;fontSize=14;" vertex="1" parent="1"><mxGeometry x="60" y="60" width="360" height="315" as="geometry"/></mxCell>
<mxCell id="python" value="&lt;div style=&quot;font-size:11px;color:#52606d;&quot;&gt;py&lt;/div&gt;&lt;pre style=&quot;background-color:#f5f7fa;border:1px solid #d5d9e0;border-radius:4px;padding:10px;font-family:Courier New;&quot;&gt;&lt;span style=&quot;color:#7c3aed;&quot;&gt;class&lt;/span&gt; Pedido:&#xa;    total = &lt;span style=&quot;color:#b45309;&quot;&gt;3.5&lt;/span&gt;  &lt;i&gt;&lt;span style=&quot;color:#6b7280;&quot;&gt;# monto&lt;/span&gt;&lt;/i&gt;&#xa;    &lt;span style=&quot;color:#7c3aed;&quot;&gt;def&lt;/span&gt; pagar(self):&#xa;        &lt;span style=&quot;color:#7c3aed;&quot;&gt;return&lt;/span&gt; &lt;span style=&quot;color:#7c3aed;&quot;&gt;None&lt;/span&gt;&lt;/pre&gt;" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;strokeColor=none;fillColor=none;fontSize=14;" vertex="1" parent="1"><mxGeometry x="520" y="360" width="239" height="128" as="geometry"/></mxCell>
<mxCell id="sql" value="&lt;div style=&quot;font-size:11px;color:#52606d;&quot;&gt;sql&lt;/div&gt;&lt;pre style=&quot;background-color:#f5f7fa;border:1px solid #d5d9e0;border-radius:4px;padding:10px;font-family:Courier New;&quot;&gt;&lt;span style=&quot;color:#7c3aed;&quot;&gt;SELECT&lt;/span&gt; id, total &lt;span style=&quot;color:#7c3aed;&quot;&gt;FROM&lt;/span&gt; pedidos &lt;span style=&quot;color:#7c3aed;&quot;&gt;WHERE&lt;/span&gt; total &amp;gt; &lt;span style=&quot;color:#b45309;&quot;&gt;10&lt;/span&gt; &lt;i&gt;&lt;span style=&quot;color:#6b7280;&quot;&gt;-- solo grandes&lt;/span&gt;&lt;/i&gt;&lt;/pre&gt;&lt;div style=&quot;font-size:11px;color:#52606d;&quot;&gt;json&lt;/div&gt;&lt;pre style=&quot;background-color:#f5f7fa;border:1px solid #d5d9e0;border-radius:4px;padding:10px;font-family:Courier New;&quot;&gt;{ &lt;span style=&quot;color:#0f7b3c;&quot;&gt;&amp;quot;ok&amp;quot;&lt;/span&gt;: &lt;span style=&quot;color:#7c3aed;&quot;&gt;true&lt;/span&gt;, &lt;span style=&quot;color:#0f7b3c;&quot;&gt;&amp;quot;n&amp;quot;&lt;/span&gt;: &lt;span style=&quot;color:#b45309;&quot;&gt;1&lt;/span&gt; }&lt;/pre&gt;&lt;pre style=&quot;background-color:#f5f7fa;border:1px solid #d5d9e0;border-radius:4px;padding:10px;font-family:Courier New;&quot;&gt;sin lenguaje &lt;span style=&quot;color:#0f7b3c;&quot;&gt;&amp;apos;texto&amp;apos;&lt;/span&gt;&lt;/pre&gt;" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;strokeColor=none;fillColor=none;fontSize=14;" vertex="1" parent="1"><mxGeometry x="520" y="620" width="558" height="185" as="geometry"/></mxCell>
