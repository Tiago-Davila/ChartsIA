{
  "name": "@chartsia/core",
  "version": "0.1.1",
  "type": "module",
  "description": "Modelo canónico, validación, layout, formas y exportadores de ChartsIA",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Tiago-Davila/ChartsIA.git",
    "directory": "packages/core"
  },
  "homepage": "https://github.com/Tiago-Davila/ChartsIA#readme",
  "bugs": "https://github.com/Tiago-Davila/ChartsIA/issues",
  "engines": {
    "node": ">=24"
  },
  "publishConfig": {
    "access": "public"
  },
  "exports": {
    ".": {
      "@chartsia/source": "./src/index.ts",
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./model": {
      "@chartsia/source": "./src/model/index.ts",
      "types": "./dist/model/index.d.ts",
      "default": "./dist/model/index.js"
    },
    "./validation": {
      "@chartsia/source": "./src/validation/index.ts",
      "types": "./dist/validation/index.d.ts",
      "default": "./dist/validation/index.js"
    },
    "./operations": {
      "@chartsia/source": "./src/operations/index.ts",
      "types": "./dist/operations/index.d.ts",
      "default": "./dist/operations/index.js"
    },
    "./shapes": {
      "@chartsia/source": "./src/shapes/index.ts",
      "types": "./dist/shapes/index.d.ts",
      "default": "./dist/shapes/index.js"
    },
    "./layout": {
      "@chartsia/source": "./src/layout/index.ts",
      "types": "./dist/layout/index.d.ts",
      "default": "./dist/layout/index.js"
    },
    "./render": {
      "@chartsia/source": "./src/render/index.ts",
      "types": "./dist/render/index.d.ts",
      "default": "./dist/render/index.js"
    },
    "./export": {
      "@chartsia/source": "./src/export/index.ts",
      "types": "./dist/export/index.d.ts",
      "default": "./dist/export/index.js"
    },
    "./import": {
      "@chartsia/source": "./src/import/index.ts",
      "types": "./dist/import/index.d.ts",
      "default": "./dist/import/index.js"
    }
  },
  "files": [
    "dist/**/*.js",
    "dist/**/*.d.ts",
    "LICENSE",
    "THIRD_PARTY_NOTICES.md"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "prepack": "cp ../../LICENSE ../../THIRD_PARTY_NOTICES.md .",
    "postpack": "rm -f LICENSE THIRD_PARTY_NOTICES.md",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run --exclude '**/*.perf.test.ts' && pnpm test:perf",
    "test:perf": "vitest run perf.test --fileParallelism=false",
    "test:golden": "vitest run test/golden"
  },
  "dependencies": {
    "elkjs": "^0.12.0",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "vitest": "^5.0.5"
  }
}
